{
  "name": "@fidy/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --ignore-lock",
    "build": "astro build && bun scripts/build-markdown.ts && bun scripts/build-headers.ts && bun scripts/check-artifact.ts",
    "build:production": "bun run build && bun scripts/stamp-release.ts",
    "typecheck": "astro sync && bun install --cwd ../../tools/astro --frozen-lockfile && bun ../../tools/astro/check.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "tailwindcss": "4.3.3",
    "turndown": "7.2.4"
  }
}
