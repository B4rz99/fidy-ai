,'four:makeFourCoreQueue(makeWorkerTelemetry(() => undefined)),current:makeCoreQueue');\nfixture='import {makeCoreQueue as makeFourCoreQueue} from \"four-runtime\";\\n'+fixture;\nconst result=await Bun.build({entrypoints:[queue+\"/handoff-worker.fixture.ts\"],target:\"browser\",external:[\"cloudflare:workers\"],plugins:[{name:\"shared-control\",setup(build){\n build.onResolve({filter:/^baseline-runtime$/},()=>({path:queue+\"/baseline-runtime.ts\"}));\n build.onResolve({filter:/baseline-dispatch$/},()=>({path:queue+\"/internal/baseline-dispatch.ts\"}));\n build.onLoad({filter:/baseline-runtime\\.ts$/},()=>({contents:runtime,loader:\"ts\"}));\n build.onLoad({filter:/baseline-dispatch\\.ts$/},()=>({contents:old,loader:\"ts\"}));\n build.onResolve({filter:/^four-runtime$/},()=>({path:queue+\"/four-runtime.ts\"}));\n build.onResolve({filter:/four-dispatch$/},()=>({path:queue+\"/internal/four-dispatch.ts\"}));\n build.onLoad({filter:/four-runtime\\.ts$/},()=>({contents:fourRuntime,loader:\"ts\"}));\n build.onLoad({filter:/four-dispatch\\.ts$/},()=>({contents:four,loader:\"ts\"}));\n build.onLoad({filter:/queue\\/internal\\/dispatch\\.ts$/},()=>({contents:wide,loader:\"ts\"}));\n build.onLoad({filter:/handoff-worker\\.fixture\\.ts$/},()=>({contents:fixture,loader:\"ts\"}));\n}}]});if(!result.success)throw new Error(String(result.logs));await Bun.write(\"/tmp/fidy-handoff-wide.mjs\",result.outputs[0]);console.log(\"Single Worker contains exact baseline and candidate queue dispatchers\");\n"
