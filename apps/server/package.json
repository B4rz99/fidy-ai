      "default": "./src/shell/email-authentication/runtime.ts"
    },
    "./onboarding-email-delivery": {
      "types": "./src/shell/email-authentication/delivery.ts",
      "import": "./src/shell/email-authentication/delivery.ts",
      "default": "./src/shell/email-authentication/delivery.ts"
    },
    "./consent-pat": {
      "types": "./src/shell/consent/pat-runtime.ts",
