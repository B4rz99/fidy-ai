{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Imports that leave a directory are aliased (`~/core/budgets/model`);
    // imports within one stay relative. Both halves are enforced by
    // `.dependency-cruiser.mjs`, which explains itself when either fires.
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tools/observability-compatibility/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**"]
}
