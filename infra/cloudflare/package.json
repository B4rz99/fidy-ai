{
  "name": "@fidy/cloudflare-infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export HOSTED_AI_MODEL=$(bun scripts/print-approved-openai-model.ts) && export ALCHEMY_HOME=$(pwd)/../../.alchemy/dev-auth && export ALCHEMY_CLI=$(pwd)/../../node_modules/alchemy/bin/alchemy.js && rm -rf \"$ALCHEMY_HOME\" && (bun \"$ALCHEMY_CLI\" profile create local --no-input) && (bun \"$ALCHEMY_CLI\" profile edit --profile local --add Cloudflare --method stored --set apiToken=local-development-placeholder --set accountId=00000000000000000000000000000000 --no-input) && ALCHEMY_PROFILE=local bun \"$ALCHEMY_CLI\" dev",
    "plan": "bun ../../node_modules/alchemy/bin/alchemy.js plan --stage production --no-input",
    "plan:site": "bun ../../node_modules/alchemy/bin/alchemy.js plan alchemy.site.ts --stage production --no-input",
    "deploy": "bun ../../node_modules/alchemy/bin/alchemy.js deploy --stage production --no-input --yes",
    "deploy:site": "bun ../../node_modules/alchemy/bin/alchemy.js deploy alchemy.site.ts --stage production --no-input --yes",
    "check:document-parsing": "bun ../../scripts/document-parsing/check.ts",
    "check:document-parsing:remote": "bun ../../scripts/document-parsing/check.ts --remote",
    "typecheck": "tsc --noEmit",
    "test": "CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 CLOUDFLARE_API_TOKEN=local-infrastructure-test-token bun --bun vitest run",
    "test:openai-conformance": "bash scripts/check-openai-conformance.sh"
  },
  "dependencies": {
    "@fidy/server": "workspace:0.0.0",
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261120.1",
    "@distilled.cloud/cloudflare": "1.0.0-rc.20",
    "@effect/platform-bun": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "alchemy": "2.0.0-beta.87",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
