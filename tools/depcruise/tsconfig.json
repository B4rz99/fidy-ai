{
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "dependency-cruiser": ["./node_modules/dependency-cruiser/types/dependency-cruiser.d.mts"]
    },
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["*.mjs"]
}
