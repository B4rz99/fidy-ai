// The one lint config. `bun run lint` runs it, `bun run lint:type-aware` runs it
// again with the rules that need type information; `bun run verify` and CI run
// both. There is deliberately no second config — a rule a tool could enforce,
// but no tool runs, is not a standard (CODING_STANDARDS.md).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "jsdoc"],
  "jsPlugins": ["./scripts/oxlint/effect-guards.js"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.repos/**"
  ],
  "rules": {
    "array-callback-return": "error",
    "effect-guards/no-sql-type-parameter": "error",
    "effect-guards/no-disable-validation": "error",
    "effect-guards/no-react-use-effect": "error",
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    "complexity": ["error", { "max": 8 }],
    "effect-guards/no-nullable-type": "error",
    "id-length": ["error", { "exceptions": ["_", "A", "E", "R"], "properties": "never" }],
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/newline-after-import": "error",
    "max-lines-per-function": ["error", { "max": 60 }],
    "max-statements": ["error", { "max": 70 }],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2, 3, 4, 100],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "sort-imports": ["error", { "ignoreDeclarationSort": true }],
    "typescript/explicit-function-return-type": "error",
    // `.mjs` is the exception: the vitest configs and the CRAP runner import
    // source-scope.mjs, where the extension is genuinely required to resolve.
    "import/extensions": ["error", "never", { "pattern": { "mjs": "always" } }],
    "no-void": "error",
    "curly": ["error", "multi-line"],
    "default-case-last": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "func-style": ["error", "expression"],
    "import/first": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-self-import": "error",
    "jsdoc/check-tag-names": "error",
    "jsdoc/empty-tags": "error",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "max-params": ["error", 3],
    "no-await-in-loop": "error",
    "no-console": "error",
    "no-constant-binary-expression": "error",
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "no-else-return": "error",
    "no-fallthrough": "error",
    "no-implicit-coercion": "error",
    "no-implied-eval": "error",
    "no-iterator": "error",
    "no-labels": "error",
    "no-lonely-if": "error",
    "no-nested-ternary": "error",
    "no-new": "error",
    "no-param-reassign": "error",
    "no-self-compare": "error",
    "no-unneeded-ternary": "error",
    "no-useless-catch": "error",
    "no-useless-return": "error",
    "no-var": "error",
    "object-shorthand": ["error", "always"],
    "oxc/no-this-in-exported-function": "error",
    "prefer-const": "error",
    "prefer-object-has-own": "error",
    "prefer-object-spread": "error",
    "radix": "error",
    "typescript/await-thenable": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true }
    ],
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "inline-type-imports" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/parameter-properties": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "yoda": "error"
  },
  "overrides": [
    // CI scripts and the tool runners report to a terminal; that is their whole
    // output channel.
    {
      "files": ["scripts/**/*.ts", "apps/server/scripts/**/*.ts", "tools/**/*.mjs"],
      "rules": {
        "no-await-in-loop": "off",
        "no-console": "off"
      }
    },
    // Contract tooling reflects raw OpenAPI JSON, whose data model necessarily includes null,
    // and coordinates a bounded set of parsing and edge steps. Keeping that wire shape literal
    // is safer than wrapping every JSON leaf in Option; the complexity is isolated from runtime.
    {
      "files": ["apps/server/tools/contracts/**/*.ts"],
      "rules": {
        "complexity": "off",
        "effect-guards/no-nullable-type": "off"
      }
    },
    {
      "files": ["apps/server/tools/contracts/vitest.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    // Vite's source and configuration contracts require extension-bearing asset imports and
    // default-exported configuration objects. TanStack Router requires interface declaration
    // merging for its registered router type.
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["apps/web/{vite,vitest}.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/web/src/router.tsx"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    // The staged generic needs its concrete canonical API to preserve each operation in the
    // resulting Atom client. Oxc cannot type the workspace source export and marks that one
    // assignment as `error`; tsc and both browser module-graph checks grade the boundary.
    {
      "files": ["apps/web/src/api-client.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "off",
        "typescript/no-unsafe-assignment": "off"
      }
    },
    // The two tooling locations below also have no types. dependency-cruiser
    // lives in an isolated install under tools/depcruise (see its package.json)
    // that the root tsconfig does not see; the custom plugin is untyped .js
    // written against oxlint's untyped JS plugin API. Its local helper import
    // carries the runtime extension Node ESM requires.
    {
      "files": ["tools/depcruise/*.mjs", "scripts/oxlint/*.js"],
      "rules": {
        "import/extensions": ["error", "never", { "pattern": { "js": "always" } }],
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    // Resolving nested aliases and utility wrappers is one recursive syntax
    // traversal. Splitting it to satisfy per-function shape limits would hide
    // the resolution state rather than simplify the algorithm.
    {
      "files": ["scripts/oxlint/dictionary-types.js"],
      "rules": {
        "complexity": "off",
        "max-depth": "off",
        "max-params": "off"
      }
    },
    // Only the runner needs the `.mjs` exception turned back off. That
    // exception keys off the *resolved* file, so it also demands an extension
    // on a package subpath that happens to resolve to one — which an
    // exports-map key cannot carry. The runner imports the cruiser's subpaths
    // and no relative .mjs at all, so the exception is all cost and no use to
    // it. The untyped plugin imports nothing, so it needs no such allowance.
    {
      "files": ["tools/depcruise/*.mjs"],
      "rules": {
        "import/extensions": ["error", "never"]
      }
    },
    // The functional-core fences (ARCHITECTURE.md §3). `no-restricted-imports`
    // is an undescribed passthrough in oxlint's schema, so a typo in these
    // options is accepted in silence and reports nothing: change them only
    // against a probe that must fail.
    //
    // `prefer-readonly-parameter-types` is unsatisfiable repo-wide — Effect's
    // own service objects are not readonly, and the only fix would be
    // suppression comments, which `typescript/ban-ts-comment` bans. Core never
    // touches a service; that is the fence, and it is why the rule can live
    // here and nowhere else. It needs type information, so it fires on the
    // type-aware pass only.
    {
      "files": ["apps/server/src/core/**"],
      "rules": {
        "effect-guards/no-ambient-nondeterminism": "error",
        "effect-guards/no-datetime-internals": "error",
        "effect-guards/no-escape-hatch": "error",
        "effect-guards/no-unknown-parameters": "error",
        "effect-guards/no-unsafe-dictionary-type": "error",
        "effect-guards/require-interface-comment": "error",
        "effect-guards/scalar-brand-only": "error",
        "no-param-reassign": ["error", { "props": true }],
        "no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "core may not read ambient process state. `argv`, `cwd`, `platform` and `env` are a shell concern, and `exit` in core would end the run from inside a pure function. Take the value as a parameter and let the shell read it."
          },
          {
            "name": "queueMicrotask",
            "message": "core may not schedule. Return a description of the work and let the shell run it."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "core may not read the clock. Take the timestamp as a parameter and let the shell call Clock."
          },
          {
            "object": "Math",
            "property": "random",
            "message": "core may not be random. Take the value as a parameter and let the shell generate it."
          },
          {
            "object": "Clock",
            "message": "core may not read the clock. Clock is an Effect default service: using it keeps the type `Effect<A, E, never>` while making the function depend on when it runs, so the requirements channel never reveals it."
          },
          {
            "object": "Random",
            "message": "core may not be random. Random is an Effect default service: using it keeps the type `Effect<A, E, never>` while making the function nondeterministic."
          },
          {
            "object": "Console",
            "message": "core may not log. Return what happened and let the shell decide whether to print it — Console is an Effect default service, so it does not appear in the requirements channel and nothing else will catch this."
          },
          {
            "object": "performance",
            "property": "now",
            "message": "core may not read the clock. `performance.now()` is a clock like any other — a monotonic one — so a core function using it depends on when it runs."
          }
        ],
        // `DateTime.Utc` carries a mutable lazy cache even though it denotes an
        // immutable instant; property reassignment remains banned above. Effect's
        // `Brand` adds phantom scalar identity, but its variance field trips this
        // deep-readonly rule. scalar-brand-only compensates by rejecting brands on
        // object schemas. Negative probes exercise both fences in lint:type-aware.
        // `Option` trips it for the same reason as `Brand`: every member is
        // readonly apart from the phantom `Unify` symbols, and no-nullable-type
        // requires it wherever a core parameter may be absent. `Json` is a
        // recursively readonly array/record union, but the rule loses that
        // fact through the recursive alias. `SchemaError` holds a decode
        // failure core reads to report which field to correct; its issue tree
        // is mutable by declaration only.
        "typescript/prefer-readonly-parameter-types": [
          "error",
          {
            "allow": [
              { "from": "package", "package": "effect", "name": "Utc" },
              { "from": "package", "package": "effect", "name": "Brand" },
              { "from": "package", "package": "effect", "name": "Option" },
              { "from": "package", "package": "effect", "name": "Json" },
              { "from": "package", "package": "effect", "name": "SchemaError" }
            ]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["~/shell", "~/shell/**", "**/shell", "**/shell/**"],
                "message": "core may not import shell. Shell may import core; the arrow only points one way (ARCHITECTURE.md §1). Take what you need as a plain parameter and let the shell supply it."
              },
              {
                "group": [
                  "effect/unstable/httpapi",
                  "effect/unstable/httpapi/**",
                  "effect/unstable/http",
                  "effect/unstable/http/**",
                  "@effect/platform-bun",
                  "@effect/platform-bun/**"
                ],
                "message": "core may not import the HTTP modules. A canonical operation's declaration — path, status code, required scope, cost class — is a delivery concern and belongs in the slice's shell contract; core holds the canonical schema and has no knowledge it is served over HTTP (ARCHITECTURE.md §4)."
              }
            ]
          }
        ]
      }
    },
    // The API harness spends the whole nesting budget by construction:
    // layer()(name, (it) => …) → it.effect(name, () => …) → Effect.gen(function* …)
    // is already three, so a test's own first `.map` would violate a limit of 3.
    // The guard is meant to catch deep nesting, not to ban array callbacks in
    // tests, so tests get one level of their own.
    {
      "files": ["**/*.test.ts", "**/*.test.js"],
      "rules": {
        "max-nested-callbacks": ["error", 4],
        "max-lines-per-function": "off",
        "no-magic-numbers": "off"
      }
    },
    // A `CREATE FUNCTION` is one indivisible statement, so a gateway body longer
    // than the limit cannot be split without routing DDL through `sql.unsafe`.
    {
      "files": ["apps/server/src/shell/db/migrations/*.ts"],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "apps/server/vitest.config.ts",
        "apps/server/vitest.core.config.ts",
        "apps/server/vitest.crap.config.ts",
        "apps/server/vitest.acceptance.config.ts",
        "apps/server/vitest.compatibility.config.ts",
        "apps/server/stryker.config.mjs",
        "apps/server/.dependency-cruiser.mjs",
        "scripts/oxlint/*.js"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
