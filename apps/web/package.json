{
  "name": "@fidy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "shadcn": "shadcn",
    "build": "bun run typecheck && bun run build:artifact",
    "build:artifact": "bun --bun vite build",
    "build:production": "bun scripts/build-production.ts",
    "typecheck": "tsc --build tsconfig.app.json",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "check:bundle": "bun scripts/check-browser-bundle.ts",
    "check:policy": "bun scripts/check-policy-integrity.ts",
    "check:shadcn": "bun scripts/check-shadcn-integrity.ts",
    "lint:deps": "bun ../../tools/depcruise/run.mjs",
    "test:browser": "bun --bun playwright test --config playwright.config.ts",
    "test:browser:cli": "CLI_ACCEPTANCE_MODE=cli bun --bun playwright test --config playwright.cli.config.ts",
    "test:desktop-navigation": "FIDY_ASSESSMENT=small CLI_ACCEPTANCE_MODE=cli bun --bun playwright test --config playwright.desktop-navigation.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@effect/atom-react": "4.1.2",
    "@effect/platform-browser": "4.1.2",
    "@fidy/server": "workspace:0.0.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "effect": "4.1.2",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "scheduler": "0.28.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@effect/platform-bun": "4.1.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-istanbul": "5.1.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
