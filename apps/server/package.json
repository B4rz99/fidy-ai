{
  "name": "@fidy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./categories": {
      "types": "./src/shell/categories/runtime.ts",
      "import": "./src/shell/categories/runtime.ts",
      "default": "./src/shell/categories/runtime.ts"
    },
    "./consent-ingress": {
      "types": "./src/shell/consent/ingress.ts",
      "import": "./src/shell/consent/ingress.ts",
      "default": "./src/shell/consent/ingress.ts"
    },
    "./categories-path": {
      "types": "./src/shell/categories/path.ts",
      "import": "./src/shell/categories/path.ts",
      "default": "./src/shell/categories/path.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./statement-parser": {
      "types": "./src/shell/ingestion/parser.ts",
      "import": "./src/shell/ingestion/parser.ts",
      "default": "./src/shell/ingestion/parser.ts"
    },
    "./telemetry": {
      "types": "./src/shell/observability/runtime.ts",
      "import": "./src/shell/observability/runtime.ts",
      "default": "./src/shell/observability/runtime.ts"
    },
    "./hosted-inference": {
      "types": "./src/shell/hosted-inference/runtime.ts",
      "import": "./src/shell/hosted-inference/runtime.ts",
      "default": "./src/shell/hosted-inference/runtime.ts"
    },
    "./hosted-inference-model": {
      "types": "./src/shell/hosted-inference/model.ts",
      "import": "./src/shell/hosted-inference/model.ts",
      "default": "./src/shell/hosted-inference/model.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contracts:generate": "bun tools/contracts/generate.ts",
    "email-formats:generate": "bun tools/email-formats/generate.ts",
    "email-formats:check": "bun tools/email-formats/generate.ts --check",
    "contracts:digest": "bun tools/contracts/digest-artifacts.ts contracts/openapi.json contracts/operation-policy.json",
    "contracts:check": "bun tools/contracts/generate.ts --check && bun tools/contracts/check.ts",
    "test:contracts": "bun --bun vitest run --config tools/contracts/vitest.config.ts",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "test:hosted-inference": "bun --bun vitest run src/shell/hosted-inference/conformance.test.ts src/shell/hosted-inference/operations.test.ts src/shell/hosted-inference/workers-ai.test.ts --coverage.enabled=false",
    "test:core": "bun --bun vitest run --config vitest.core.config.ts",
    "test:email-interpretation": "bun --bun vitest run --config vitest.email-interpretation.config.ts",
    "test:mutation": "node ../../tools/mutation/run.mjs",
    "check:browser-client": "bun scripts/check-browser-client.ts",
    "lint:deps": "bun ../../tools/depcruise/run.mjs . src scripts tools",
    "lint:deps:probes": "bun scripts/check-dependency-guards.ts",
    "check:lint-guards": "bun scripts/check-lint-guards.ts"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "effect": "4.0.0-rc.115",
    "jose": "6.2.12",
    "parse5": "8.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "@vitest/coverage-istanbul": "5.0.1",
    "bun-types": "1.4.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
