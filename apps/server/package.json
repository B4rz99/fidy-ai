      "default": "./src/shell/transactions/continuation.ts"
    },
    "./transaction-routes": {
      "types": "./src/shell/transactions/cloudflare-routes.ts",
      "import": "./src/shell/transactions/cloudflare-routes.ts",
      "default": "./src/shell/transactions/cloudflare-routes.ts"
    },
    "./transaction-capture": {
      "types": "./src/shell/transactions/capture.ts",
      "import": "./src/shell/transactions/capture.ts",
      "default": "./src/shell/transactions/capture.ts"
    },
    "./transactions-runtime": {
      "types": "./src/core/transactions/model.ts",
      "import": "./src/core/transactions/model.ts",
      "default": "./src/core/transactions/model.ts"
    },
    "./memory-runtime": {
      "types": "./src/shell/memory/runtime.ts",
      "import": "./src/shell/memory/runtime.ts",
      "default": "./src/shell/memory/runtime.ts"
    },
    "./memory-routes": {
      "types": "./src/shell/memory/cloudflare-routes.ts",
      "import": "./src/shell/memory/cloudflare-routes.ts",
      "default": "./src/shell/memory/cloudflare-routes.ts"
    },
    "./categories": {
      "types": "./src/shell/categories/runtime.ts",
      "import": "./src/shell/categories/runtime.ts",
      "default": "./src/shell/categories/runtime.ts"
    },
    "./onboarding-verification": {
      "types": "./src/shell/email-authentication/onboarding.ts",
