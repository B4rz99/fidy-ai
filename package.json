{
  "name": "fidy-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings --config .oxlintrc.json .",
    "lint:type-aware": "oxlint --deny-warnings --config .oxlintrc.json --type-aware . && bun scripts/check-lint-guards.ts",
    "lint:suppressions": "bun scripts/check-lint-suppressions.ts",
    "lint:deps": "bun tools/depcruise/run.mjs && bun run lint:deps:probes",
    "lint:deps:probes": "bun scripts/check-dependency-guards.ts",
    "lint:dependencies": "bun scripts/check-dependency-updates.ts",
    "dev": "bun scripts/seed-development.ts && FIDY_HTTP_HOST=127.0.0.1 bun --preload ./src/shell/observability/preload.ts src/main.ts",
    "build:production": "rm -rf dist && bun build src/shell/observability/preload.ts src/main.ts --target=bun --outdir=dist --entry-naming='[name].js' --sourcemap=external && bun build scripts/provision-runtime-role.ts scripts/migrate.ts --target=bun --outdir=dist/commands --entry-naming='[name].js' --sourcemap=external && bunx --bun sentry-cli sourcemaps inject dist",
    "start:production": "bun --preload ./dist/preload.js dist/main.js",
    "agent:repl": "bun scripts/agent-repl.ts",
    "sentry:verify": "bun scripts/verify-sentry-account.ts",
    "sentry:smoke:build": "bun build scripts/smoke-sentry-account.ts --target=bun --outdir=reports/sentry-smoke --entry-naming=smoke.js --sourcemap=external",
    "sentry:smoke": "bun reports/sentry-smoke/smoke.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:acceptance": "bun --bun vitest run --config vitest.acceptance.config.ts",
    "test:core": "bun --bun vitest run --config vitest.core.config.ts",
    "test:observability-compatibility": "bun --bun vitest run --config vitest.compatibility.config.ts",
    "test:crap": "bun --bun vitest run --config vitest.crap.config.ts --coverage && bun tools/crap/run.mjs",
    "test:mutation": "node tools/mutation/run.mjs",
    "check:production-image": "bash scripts/check-production-image.sh",
    "verify": "bun run lint:suppressions && bun run lint && bun run lint:type-aware && bun run lint:deps && bun run lint:dependencies && bun run format:check && bun run typecheck && bun run test && bun run test:mutation",
    "postinstall": "effect-tsgo patch",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0-beta.98",
    "@effect/platform-bun": "4.0.0-beta.98",
    "@effect/sql-pg": "4.0.0-beta.98",
    "@kapso/whatsapp-cloud-api": "0.2.3",
    "@sentry/bun": "10.69.0",
    "effect": "4.0.0-beta.98"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.98",
    "@sentry/cli": "2.58.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "bun-types": "1.3.14",
    "lefthook": "2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "packageManager": "bun@1.3.14"
}
