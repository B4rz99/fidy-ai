{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "../../.tsbuild/server",
    "tsBuildInfoFile": "../../.tsbuild/server.tsbuildinfo",
    "lib": ["ESNext", "WebWorker"],
    "types": ["bun-types", "@cloudflare/workers-types"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "cloudflare/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.json",
    "tools/contracts/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/build/**"]
}
