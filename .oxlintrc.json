{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "jsdoc", "react", "jsx-a11y"],
  "jsPlugins": [
    "./scripts/oxlint/effect-guards.js",
    "./scripts/oxlint/test-guards.js",
    "./scripts/oxlint/effect-recovery.js",
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "landmines",
      "specifier": "./tools/oxlint/anti-slop/plugins/landmines.ts"
    },
    {
      "name": "ai-guard",
      "specifier": "./tools/oxlint/anti-slop/plugins/ai-guard.ts"
    },
    {
      "name": "enfect",
      "specifier": "./tools/oxlint/anti-slop/plugins/enfect.ts"
    },
    {
      "name": "effect",
      "specifier": "./tools/oxlint/anti-slop/plugins/effect.ts"
    },
    {
      "name": "anti-slop-effect-jev",
      "specifier": "./tools/oxlint/anti-slop/jev/plugin.ts"
    },
    {
      "name": "anti-slop-martinfowler-jev",
      "specifier": "./tools/oxlint/anti-slop/martinfowler/jev-plugin.ts"
    }
  ],
  "extends": ["./.oxlintrc.ui.json"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.repos/**",
    ".agents/skills/install-anti-slop/**",
    ".claude/skills/install-anti-slop/**",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/oxlint-plugin-jev/**"
  ],
  "rules": {
    "test-guards/no-module-mocks": "error",
    "test-guards/no-tsx-tests": "error",
    "test-guards/no-react-test-tools": "error",
    "array-callback-return": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "effect-guards/no-sql-type-parameter": "error",
    "effect-guards/no-disable-validation": "error",
    "effect-guards/no-effect-promise": "error",
    "effect-recovery/no-catch-succeed-none": "error",
    "effect-guards/no-type-cast": "error",
    "effect-guards/no-react-use-effect": "error",
    "capitalized-comments": [
      "error",
      "always",
      {
        "ignoreConsecutiveComments": true,
        "ignorePattern": "^react-doctor-disable(?:-next-line)?\\b"
      }
    ],
    "complexity": [
      "error",
      {
        "max": 8
      }
    ],
    "effect-guards/no-nullable-type": "error",
    "id-length": [
      "error",
      {
        "exceptions": ["_", "A", "E", "R"],
        "properties": "never"
      }
    ],
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/newline-after-import": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 60,
        "skipBlankLines": true
      }
    ],
    "max-statements": [
      "error",
      {
        "max": 70
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2, 3, 4, 100],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true
      }
    ],
    "typescript/explicit-function-return-type": "error",
    "import/extensions": [
      "error",
      "never",
      {
        "pattern": {
          "mjs": "always",
          "css": "always",
          "html": "always",
          "json": "always",
          "astro": "always",
          "woff2": "always"
        }
      }
    ],
    "no-void": "error",
    "curly": ["error", "multi-line"],
    "default-case-last": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "func-style": ["error", "expression"],
    "import/first": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-self-import": "error",
    "jsdoc/check-tag-names": [
      "error",
      {
        "definedTags": ["effect-expect-leaking"]
      }
    ],
    "jsdoc/empty-tags": "error",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "max-params": ["error", 3],
    "no-await-in-loop": "error",
    "no-console": "error",
    "no-constant-binary-expression": "error",
    "no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "no-else-return": "error",
    "no-fallthrough": "error",
    "no-implicit-coercion": "error",
    "no-implied-eval": "error",
    "no-iterator": "error",
    "no-labels": "error",
    "no-lonely-if": "error",
    "no-nested-ternary": "error",
    "no-new": "error",
    "no-param-reassign": "error",
    "no-self-compare": "error",
    "no-unneeded-ternary": "error",
    "no-useless-catch": "error",
    "no-useless-return": "error",
    "no-var": "error",
    "object-shorthand": ["error", "always"],
    "oxc/no-this-in-exported-function": "error",
    "prefer-const": "error",
    "prefer-object-has-own": "error",
    "prefer-object-spread": "error",
    "radix": "error",
    "typescript/await-thenable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": true,
        "ts-ignore": true,
        "ts-nocheck": true
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "effect-guards/no-ordinary-interface": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/parameter-properties": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "yoda": "error",
    "anti-slop/max-ternary-depth": [
      "error",
      {
        "maxDepth": 2
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-spread": "error",
    "anti-slop/no-dev-env-branch": "error",
    "anti-slop/no-disabled-type-assertion-rules": "error",
    "anti-slop/no-instanceof": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-reprovide-ambient-service": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "landmines/strict-msw": "error",
    "landmines/no-fixed-sleep": "error",
    "landmines/no-unsignaled-poll": "error",
    "landmines/no-flake-masking": "error",
    "ai-guard/no-placeholder-implementation": "error",
    "ai-guard/no-test-env-branch": "error",
    "ai-guard/no-tautological-assertion": "error",
    "ai-guard/no-assertionless-test": "error",
    "ai-guard/no-undeclared-import": "error",
    "ai-guard/no-silent-fallback": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-manual-tagged-type": "error",
    "anti-slop-effect/no-ordie-in-service-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/no-service-parameters": "error",
    "anti-slop-effect/no-static-effect-service-forwarders": "error",
    "anti-slop-effect/no-test-code-in-src": "error",
    "anti-slop-effect/no-unbounded-retry": "error",
    "anti-slop-effect/prefer-effect-match": "error",
    "anti-slop-effect/prefer-tagged-error-handling": "error",
    "anti-slop-effect/prefer-yield-service": "error",
    "anti-slop-effect/require-cause-when-narrowing": "error",
    "anti-slop-effect/require-operation-span": "error",
    "anti-slop-effect/require-service-make-layer": "error",
    "anti-slop-effect/stream-large-files": "error",
    "anti-slop-effect/throw-in-effect-gen": "error",
    "effect/noAliasTestLayer": "error",
    "effect/noEagerAcquire": "error",
    "effect/noManagedRuntimeInEffect": "error",
    "effect/noPerCallCacheConstruction": "error",
    "effect/noPointFreeLog": "error",
    "effect/noRunCollectOnUnboundedStream": "error",
    "effect/noSilentCatchAll": "error",
    "effect/noUnboundedConcurrency": "error",
    "effect/requireSuppressionReason": "error",
    "effect/requireForceKillAfter": "error",
    "enfect/effect-promise-vs-trypromise": "error",
    "enfect/prefer-redacted-config": "error",
    "enfect/avoid-option-getorthrow": "error",
    "enfect/effect-run-in-body": "error",
    "enfect/no-cause-in-http-response": "error",
    "enfect/no-effect-ignore-then-as": "error",
    "enfect/avoid-expect-in-if": "error",
    "enfect/prefer-duration-constructors": "error",
    "enfect/avoid-mutable-state": "error",
    "enfect/prefer-option-over-null": "error",
    "enfect/yield-in-for-loop": "warn",
    "anti-slop-effect-jev/cache-in-method": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/decode-after-status": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/error-as-value": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/network-call-in-transaction": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/read-then-write-race": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/shallow-service": "off",
    "anti-slop-effect-jev/single-use-abstraction": "off",
    "anti-slop-effect-jev/swallow-without-capture": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/unbounded-fanout": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/unbounded-retry": [
      "error",
      {
        "mode": "changed"
      }
    ],
    "anti-slop-effect-jev/test-cannot-fail": "off",
    "anti-slop-martinfowler-jev/comments": "off",
    "anti-slop-martinfowler-jev/data-class": "off",
    "anti-slop-martinfowler-jev/data-clumps": "off",
    "anti-slop-martinfowler-jev/feature-envy": "off",
    "anti-slop-martinfowler-jev/insider-trading": "off",
    "anti-slop-martinfowler-jev/lazy-element": "off",
    "anti-slop-martinfowler-jev/middle-man": "off",
    "anti-slop-martinfowler-jev/mysterious-name": "off",
    "anti-slop-martinfowler-jev/primitive-obsession": "off",
    "anti-slop-martinfowler-jev/repeated-switches": "off",
    "anti-slop-martinfowler-jev/speculative-generality": "off",
    "anti-slop-martinfowler-jev/temporary-field": "off"
  },
  "overrides": [
