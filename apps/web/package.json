{
  "name": "@fidy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && bun --bun vite build",
    "build:production": "bun scripts/build-production.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "check:bundle": "bun scripts/check-browser-bundle.ts",
    "check:policy": "bun scripts/check-policy-integrity.ts",
    "lint:deps": "bun ../../tools/depcruise/run.mjs",
    "lint:deps:probes": "bun scripts/check-dependency-guards.ts",
    "test:browser": "bun --bun playwright test --config playwright.config.ts",
    "test:browser:cli": "CLI_ACCEPTANCE_MODE=cli bun --bun playwright test --config playwright.cli.config.ts",
    "check:foldkit": "bun scripts/check-foldkit-integrity.ts"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@effect/platform-browser": "4.0.1",
    "@fidy/server": "workspace:0.0.0",
    "@hugeicons/core-free-icons": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.1",
    "foldkit": "0.166.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@effect/platform-bun": "4.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@vitest/coverage-istanbul": "5.0.3",
    "jsdom": "30.0.1",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
