{
  "name": "@fidy/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "dev": "bun scripts/seed-development-runtime.ts && FIDY_HTTP_HOST=127.0.0.1 bun --preload ./src/shell/observability/internal/preload.ts src/main.ts",
    "build:production": "rm -rf dist && CONTRACT_DIGEST=$(bun run --silent contracts:digest) && [[ \"$CONTRACT_DIGEST\" =~ ^[0-9a-f]{64}$ ]] && bun build src/shell/observability/internal/preload.ts src/main.ts --target=bun --outdir=dist --entry-naming='[name].js' --sourcemap=external --define \"FIDY_CONTRACT_DIGEST=\\\"$CONTRACT_DIGEST\\\"\" && bun build scripts/prepare-sentry-release-runtime.ts --target=bun --outdir=dist/commands --entry-naming='prepare-sentry-release.js' --sourcemap=external && bun build scripts/provision-runtime-role.ts scripts/support-recovery.ts --target=bun --outdir=dist/commands --entry-naming='[name].js' --sourcemap=external && bun build scripts/migrate-runtime.ts --target=bun --outdir=dist/commands --entry-naming='migrate.js' --sourcemap=external && bun build scripts/approve-email-ingest-sample-runtime.ts --target=bun --outdir=dist/commands --entry-naming='approve-email-ingest-sample.js' --sourcemap=external && bunx --bun sentry-cli sourcemaps inject dist",
    "start:production": "bun --preload ./dist/preload.js dist/main.js",
    "agent:repl": "bun scripts/agent-repl-runtime.ts",
    "mistral:conformance": "bun scripts/verify-mistral-token-counts.ts",
    "evaluate:es-co": "./scripts/evaluate-es-co.sh",
    "test:evaluation": "./scripts/evaluate-es-co.sh test",
    "support:recovery": "bun scripts/support-recovery.ts",
    "sentry:verify": "bun scripts/verify-sentry-account-runtime.ts",
    "wompi:reconcile-enrollment": "bun scripts/reconcile-wompi-enrollment-runtime.ts",
    "wompi:sandbox:verify-source": "bun scripts/verify-wompi-sandbox-source.ts",
    "sentry:smoke:build": "bun build scripts/smoke-sentry-account-runtime.ts --target=bun --outdir=reports/sentry-smoke --entry-naming=smoke.js --sourcemap=external",
    "sentry:smoke": "bun reports/sentry-smoke/smoke.js",
    "typecheck": "tsc --noEmit",
    "contracts:generate": "bun tools/contracts/generate.ts",
    "email-formats:generate": "bun tools/email-formats/generate.ts",
    "email-formats:check": "bun tools/email-formats/generate.ts --check",
    "contracts:digest": "bun tools/contracts/digest-artifacts.ts contracts/openapi.json contracts/operation-policy.json",
    "contracts:check": "bun tools/contracts/generate.ts --check && bun tools/contracts/check.ts",
    "test:contracts": "bun --bun vitest run --config tools/contracts/vitest.config.ts",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "test:acceptance": "bun --bun vitest run --config vitest.acceptance.config.ts",
    "test:ci": "rm -rf coverage reports && bun --bun vitest run --config vitest.ci.config.ts --coverage",
    "test:core": "bun --bun vitest run --config vitest.core.config.ts",
    "test:email-interpretation": "bun --bun vitest run --config vitest.email-interpretation.config.ts",
    "test:observability-compatibility": "bun --bun vitest run --config vitest.compatibility.config.ts",
    "test:durable-compatibility": "bun --bun vitest run --config vitest.durable-compatibility.config.ts",
    "test:quality": "bun ../../scripts/ci/merge-server-coverage.ts --input ${SERVER_COVERAGE_INPUT:-coverage} --output coverage/coverage-final.json && bun ../../tools/crap/run.mjs",
    "test:mutation": "node ../../tools/mutation/run.mjs",
    "check:production-image": "bash scripts/check-production-image.sh",
    "check:browser-client": "bun scripts/check-browser-client.ts",
    "lint:deps": "bun ../../tools/depcruise/run.mjs . src scripts tools",
    "lint:deps:probes": "bun scripts/check-dependency-guards.ts",
    "check:lint-guards": "bun scripts/check-lint-guards.ts",
    "check:migration-ids": "bun scripts/check-migration-ids.ts",
    "migrate": "bun scripts/migrate-runtime.ts",
    "approve:email-ingest-sample": "bun scripts/approve-email-ingest-sample-runtime.ts"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0-rc.112",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@sentry/bun": "10.74.0",
    "csv-parse": "7.0.2",
    "effect": "4.0.0-rc.112",
    "jose": "6.2.12",
    "js-tiktoken": "1.0.21",
    "parse5": "8.0.1",
    "sharp": "0.35.4",
    "svix": "2.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "@sentry/cli": "3.7.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "bun-types": "1.4.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
