  "measurementWorkerSource": "import {WorkflowEntrypoint} from 'cloudflare:workers';\nconst key='synthetic-generation',generation='initial';\nasync function probe(bucket){\n const results=[];let reads=0,writes=0;\n await bucket.put(key,generation,{customMetadata:{generation}});writes++;\n try{\n  for(let i=-2;i<32;i++){\n   const mode=i===-2?'get':i===-1?'head':i%4===0||i%4===3?'get':'head';\n   const start=performance.now(),object=await bucket[mode](key);reads++;\n   const metadataMs=performance.now()-start;\n   if(object===null||object.size!==generation.length)throw Error('Fixture object mismatch');\n   const value=mode==='get'?await object.text():object.customMetadata?.generation;\n   const elapsedMs=performance.now()-start;\n   if(value!==generation)throw Error('Fixture generation mismatch');\n   results.push({mode,warmup:i<0,metadataMs,elapsedMs,bodyMs:elapsedMs-metadataMs});\n  }\n }finally{await bucket.delete(key);writes++}\n return{scope:'Isolated synthetic R2 protocol comparison only; no D1 binding or production authority changes. Head uses fixture metadata; production still reads its authoritative body.',reads,writes,results};\n}\nexport default {async fetch(request,env){return Response.json(await probe(env.BUCKET))}};\nexport class BodyHeadProof extends WorkflowEntrypoint{\n async run(event,step){if(event.payload?.proof!=='body-head-20261030')throw Error('Invalid proof request');if(event.payload.cleanup===true)return step.do('cleanup',{retries:{limit:0,delay:1},timeout:'30 seconds'},async()=>{const listing=await this.env.BUCKET.list({limit:2});if(listing.truncated||listing.objects.some(o=>o.key!==key))throw Error('Unexpected fixture keyspace');if(listing.objects.length)await this.env.BUCKET.delete(key);return{removed:listing.objects.length}});return step.do('bounded-body-head',{retries:{limit:0,delay:1},timeout:'2 minutes'},()=>probe(this.env.BUCKET))}\n}\n",
