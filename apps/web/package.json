{
  "name": "@fidy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "shadcn": "shadcn",
    "build": "tsc --noEmit && bun --bun vite build",
    "build:preview": "bun scripts/build-preview.ts",
    "build:production": "bun scripts/build-production.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:preview-policy": "bun --bun vitest run cloudflare/preview-policy",
    "check:bundle": "bun scripts/check-browser-bundle.ts",
    "check:policy": "bun scripts/check-policy-integrity.ts",
    "check:shadcn": "bun scripts/check-shadcn-integrity.ts",
    "lint:deps": "bun ../../tools/depcruise/run.mjs",
    "lint:deps:probes": "bun scripts/check-dependency-guards.ts",
    "test:browser": "bun --bun playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@effect/atom-react": "4.0.0-beta.98",
    "@fidy/server": "workspace:0.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-router": "1.170.31",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.0.0-beta.98",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "scheduler": "0.27.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-istanbul": "4.1.11",
    "jsdom": "30.0.1",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
