---
import { LaunchButton } from "../../islands/registration";
---

<section class="detail-hero wrap">
  <h1>
    Lo importante para ti,
    <br />a primera vista.
  </h1>
  <p>
    Organiza tu dashboard con las cifras y las transacciones que quieres tener cerca. Una vista
    personal de tu información en Fidy.
  </p>
  <div class="actions">
    <LaunchButton dark={false} arrow />
    <a class="textlink" href="#vista">
      Ver el ejemplo ↓
    </a>
  </div>
</section>
<section class="detail-showcase" id="vista" aria-label="Vista ilustrativa de Tablero">
  <div class="wrap">
    <div class="detail-dashboard">
      <div class="detail-app-title">
        <b>Mi panorama</b>
        <span>Octubre · COP</span>
      </div>
      <div class="detail-widget-grid">
        <article>
          <span>Gastos registrados</span>
          <strong>$1.084.000</strong>
          <small>A partir de tus transacciones</small>
        </article>
        <article>
          <span>Restaurantes disponible</span>
          <strong>$216.000</strong>
          <div class="feature-track">
            <i class="chart-width-64"></i>
          </div>
        </article>
        <article class="detail-spending">
          <h3>Gastos por categoría</h3>
          <div class="detail-category">
            <span>Mercado</span>
            <b>$520.000</b>
            <div class="feature-track">
              <i class="chart-width-100"></i>
            </div>
          </div>
          <div class="detail-category">
            <span>Restaurantes</span>
            <b>$384.000</b>
            <div class="feature-track">
              <i class="chart-width-74"></i>
            </div>
          </div>
          <div class="detail-category">
            <span>Transporte</span>
            <b>$180.000</b>
            <div class="feature-track">
              <i class="chart-width-35"></i>
            </div>
          </div>
        </article>
        <article>
          <h3>Últimas transacciones</h3>
          <div class="feature-record">
            <span>
              Crepes
              <small>Restaurantes</small>
            </span>
            <b>− $28.000</b>
          </div>
          <div class="feature-record">
            <span>
              Mercado
              <small>Mercado</small>
            </span>
            <b>− $156.000</b>
          </div>
          <div class="feature-record">
            <span>
              Transporte
              <small>Transporte</small>
            </span>
            <b>− $12.000</b>
          </div>
        </article>
      </div>
    </div>
    <p class="detail-disclosure">
      Vista ilustrativa · Datos ficticios en COP · No modifica tu información.
    </p>
  </div>
</section>
<section class="section wrap">
  <div class="section-head">
    <h2>Un espacio que puedes organizar.</h2>
  </div>
  <div class="steps">
    <article class="step">
      <h3>Elige qué ver.</h3>
      <p>
        Combina métricas, gastos por categoría, presupuestos y listas de transacciones en tu
        dashboard.
      </p>
    </article>
    <article class="step">
      <h3>Dale tu orden.</h3>
      <p>Reorganiza los widgets para que la información que más consultas tenga su lugar.</p>
    </article>
    <article class="step">
      <h3>Conserva la perspectiva.</h3>
      <p>
        Cada cifra parte de tus transacciones. Consulta el detalle para entender qué hay detrás del
        total.
      </p>
    </article>
  </div>
</section>
