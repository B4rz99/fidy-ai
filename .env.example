# Public namespace used by local API composition and the browser build
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
VITE_API_ORIGIN=http://localhost:3000

# WhatsApp channel (Kapso)
KAPSO_API_KEY=
WHATSAPP_BUSINESS_PORTFOLIO_ID=
WHATSAPP_DELIVERY_MODE=bsuid

# Card payments (Wompi; keep real credentials only in the untracked root .env)
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=

# Outbound email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=obarboza@fidyapp.com
RESEND_FROM_NAME=Fidy
