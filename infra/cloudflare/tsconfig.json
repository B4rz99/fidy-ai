{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "../../.tsbuild/cloudflare",
    "tsBuildInfoFile": "../../.tsbuild/cloudflare.tsbuildinfo",
    "lib": ["ESNext", "WebWorker"],
