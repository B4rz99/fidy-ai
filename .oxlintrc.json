{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "jsdoc"],
  "jsPlugins": ["./scripts/oxlint/effect-guards.js", "./scripts/oxlint/foldkit-style.js"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.repos/**"
  ],
  "rules": {
    "array-callback-return": "error",
    "effect-guards/no-sql-type-parameter": "error",
    "effect-guards/no-disable-validation": "error",
    "effect-guards/no-effect-promise": "error",
    "effect-guards/no-type-cast": "error",
    "capitalized-comments": [
      "error",
      "always",
      {
        "ignoreConsecutiveComments": true
      }
    ],
    "complexity": [
      "error",
      {
        "max": 8
      }
    ],
    "effect-guards/no-nullable-type": "error",
    "id-length": [
      "error",
      {
        "exceptions": ["_", "A", "E", "R"],
        "properties": "never"
      }
    ],
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/newline-after-import": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 60
      }
    ],
    "max-statements": [
      "error",
      {
        "max": 70
      }
    ],
    "no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1, 2, 3, 4, 100],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "sort-imports": [
      "error",
      {
        "ignoreDeclarationSort": true
      }
    ],
    "typescript/explicit-function-return-type": "error",
    "import/extensions": [
      "error",
      "never",
      {
        "pattern": {
          "mjs": "always",
          "css": "always",
          "html": "always"
        }
      }
    ],
    "no-void": "error",
    "curly": ["error", "multi-line"],
    "default-case-last": "error",
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "func-style": ["error", "expression"],
    "import/first": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-self-import": "error",
    "jsdoc/check-tag-names": [
      "error",
      {
        "definedTags": ["effect-expect-leaking"]
      }
    ],
    "jsdoc/empty-tags": "error",
    "jsdoc/require-param-description": "error",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "max-params": ["error", 3],
    "no-await-in-loop": "error",
    "no-console": "error",
    "no-constant-binary-expression": "error",
    "no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "no-else-return": "error",
    "no-fallthrough": "error",
    "no-implicit-coercion": "error",
    "no-implied-eval": "error",
    "no-iterator": "error",
    "no-labels": "error",
    "no-lonely-if": "error",
    "no-nested-ternary": "error",
    "no-new": "error",
    "no-param-reassign": "error",
    "no-self-compare": "error",
    "no-unneeded-ternary": "error",
    "no-useless-catch": "error",
    "no-useless-return": "error",
    "no-var": "error",
    "object-shorthand": ["error", "always"],
    "oxc/no-this-in-exported-function": "error",
    "prefer-const": "error",
    "prefer-object-has-own": "error",
    "prefer-object-spread": "error",
    "radix": "error",
    "typescript/await-thenable": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": true,
        "ts-ignore": true,
        "ts-nocheck": true
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "effect-guards/no-ordinary-interface": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/parameter-properties": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "yoda": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/src/**/*.ts"],
      "rules": {
        "foldkit-style/semantic-colors": "error"
      }
    },
    {
      "files": ["apps/web/src/ui/button-variants.ts"],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["apps/cli/vitest.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["infra/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@fidy/server/client", "**/server/src/client", "**/server/src/client.ts"],
                "message": "Infrastructure consumes final owner contracts, never the outward browser publication root (#615)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/cloudflare/agent/internal/hosted-turn.ts"],
      "rules": {
        "complexity": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["apps/server/cloudflare/agent/internal/turn-store.ts"],
      "rules": {
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "apps/server/scripts/check-dependency-guards.ts",
        "apps/web/scripts/check-dependency-guards.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["tools/depcruise/run.mjs", "tools/mutation/run.mjs"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["apps/server/cloudflare/ingestion/internal/forwarded-email.ts"],
      "rules": {
        "complexity": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": [
        "apps/server/tools/contracts/vitest.config.ts",
        "scripts/vitest.config.ts",
        "scripts/infra-performance/vitest.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "scripts/mcp/production-browser.ts",
        "apps/web/src/ui/class-names.ts",
        "apps/web/e2e/{browser-pairing,static-shell}.spec.ts",
        "apps/web/{playwright,vite,vitest}.config.ts",
        "apps/web/src/testing/setup.ts"
      ],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["apps/web/{playwright,playwright.cli,playwright.oauth,vite,vitest}.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "infra/cloudflare/alchemy.run.ts",
        "infra/cloudflare/alchemy-drift.run.ts",
        "apps/server/cloudflare/core-worker.ts",
        "apps/server/cloudflare/d1-migration-test-worker.fixture.ts",
        "apps/server/cloudflare/ingestion/email-worker.ts",
        "apps/server/cloudflare/documents/document-extraction-worker.ts",
        "apps/server/cloudflare/documents/document-parsing-worker.ts",
        "apps/server/cloudflare/documents/durable-parser-proof-worker.ts",
        "apps/server/cloudflare/documents/protected-document-worker.ts",
        "apps/server/cloudflare/public-worker.ts",
        "apps/server/cloudflare/resource-admission/resource-admission-worker.fixture.ts",
        "apps/server/cloudflare/coordinator-test-harness.ts",
        "apps/server/cloudflare/queue/recovery-worker.fixture.ts",
        "apps/server/cloudflare/ai/workers-ai-conformance-worker.ts",
        "infra/cloudflare/vitest.config.ts",
        "apps/server/cloudflare/vitest.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["infra/cloudflare/alchemy.run.ts"],
      "rules": {
        "max-lines-per-function": "off",
        "complexity": "off"
      }
    },
    {
      "files": ["apps/server/cloudflare/subscription/internal/payment-enrollment.ts"],
      "rules": {
        "complexity": "off",
        "max-lines-per-function": "off"
      }
    },
    {
      "files": ["apps/server/cloudflare/resource-admission/resource-admission.test.ts"],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["apps/web/src/**/*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Web features must use the canonical transport seam; only transport may own the browser HttpClient."
          }
        ]
      }
    },
    {
      "files": ["tools/depcruise/*.mjs"],
      "rules": {
        "import/extensions": [
          "error",
          "never",
          {
            "pattern": {
              "js": "always"
            }
          }
        ]
      }
    },
    {
      "files": ["scripts/oxlint/*.js"],
      "rules": {
        "import/extensions": [
          "error",
          "never",
          {
            "pattern": {
              "js": "always"
            }
          }
        ]
      }
    },
    {
      "files": ["scripts/oxlint/lint-rules.test.js"],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["tools/depcruise/*.mjs"],
      "rules": {
        "import/extensions": "off"
      }
    },
    {
      "files": ["apps/server/src/core/**"],
      "rules": {
        "effect-guards/no-ambient-nondeterminism": "error",
        "effect-guards/no-datetime-internals": "error",
        "effect-guards/no-escape-hatch": "error",
        "effect-guards/no-unknown-parameters": "error",
        "effect-guards/no-unsafe-dictionary-type": "error",
        "effect-guards/require-interface-comment": "error",
        "effect-guards/scalar-brand-only": "error",
        "no-param-reassign": [
          "error",
          {
            "props": true
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "core may not read ambient process state. `argv`, `cwd`, `platform` and `env` are a shell concern, and `exit` in core would end the run from inside a pure function. Take the value as a parameter and let the shell read it."
          },
          {
            "name": "queueMicrotask",
            "message": "core may not schedule. Return a description of the work and let the shell run it."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "core may not read the clock. Take the timestamp as a parameter and let the shell call Clock."
          },
          {
            "object": "Math",
            "property": "random",
            "message": "core may not be random. Take the value as a parameter and let the shell generate it."
          },
          {
            "object": "Clock",
            "message": "core may not read the clock. Clock is an Effect default service: using it keeps the type `Effect<A, E, never>` while making the function depend on when it runs, so the requirements channel never reveals it."
          },
          {
            "object": "Random",
            "message": "core may not be random. Random is an Effect default service: using it keeps the type `Effect<A, E, never>` while making the function nondeterministic."
          },
          {
            "object": "Console",
            "message": "core may not log. Return what happened and let the shell decide whether to print it \u2014 Console is an Effect default service, so it does not appear in the requirements channel and nothing else will catch this."
          },
          {
            "object": "performance",
            "property": "now",
            "message": "core may not read the clock. `performance.now()` is a clock like any other \u2014 a monotonic one \u2014 so a core function using it depends on when it runs."
          }
        ],
        "typescript/prefer-readonly-parameter-types": [
          "error",
          {
            "allow": [
              {
                "from": "package",
                "package": "effect",
                "name": "Utc"
              },
              {
                "from": "package",
                "package": "effect",
                "name": "Brand"
              },
              {
                "from": "package",
                "package": "effect",
                "name": "Option"
              },
              {
                "from": "package",
                "package": "effect",
                "name": "Json"
              },
              {
                "from": "package",
                "package": "effect",
                "name": "SchemaError"
              }
            ]
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["~/shell", "~/shell/**", "**/shell", "**/shell/**"],
                "message": "core may not import shell. Shell may import core; the arrow only points one way (ARCHITECTURE.md \u00a71). Take what you need as a plain parameter and let the shell supply it."
              },
              {
                "group": ["effect/http-api", "effect/http-api/**", "effect/http", "effect/http/**"],
                "message": "core may not import the HTTP modules. A canonical operation's declaration \u2014 path, status code, required scope, cost class \u2014 is a delivery concern and belongs in the slice's shell contract; core holds the canonical schema and has no knowledge it is served over HTTP (ARCHITECTURE.md \u00a74)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/server/src/shell/ingestion/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:crypto",
                "message": "Ingestion must use the Effect Crypto service (`import { Crypto } from \"effect\"; const crypto = yield* Crypto.Crypto`) so cryptographic failures stay typed and tests can provide a controlled implementation."
              },
              {
                "name": "crypto",
                "message": "Ingestion must use the Effect Crypto service (`import { Crypto } from \"effect\"; const crypto = yield* Crypto.Crypto`) so cryptographic failures stay typed and tests can provide a controlled implementation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.js",
        "apps/server/cloudflare/oauth-agents/oauth-ingress.test-fixture.ts"
      ],
      "rules": {
        "max-nested-callbacks": ["error", 4],
        "max-lines-per-function": "off",
        "no-magic-numbers": "off"
      }
    },
    {
      "files": [
        "apps/server/vitest.config.ts",
        "apps/server/vitest.core.config.ts",
        "apps/server/vitest.email-interpretation.config.ts",
        "apps/server/vitest.whatsapp.config.ts",
        "apps/server/stryker.config.mjs",
        "apps/web/.dependency-cruiser.mjs",
        "apps/cli/.dependency-cruiser.mjs",
        "apps/server/.dependency-cruiser.mjs",
        "scripts/oxlint/*.js"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ]
}
