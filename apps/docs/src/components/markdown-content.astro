---
import DefaultMarkdownContent from "@astrojs/starlight/components/MarkdownContent.astro";
import Home from "./docs-home.astro";
import NotFound from "./docs-not-found.astro";
import MarkdownActions from "./markdown-actions.astro";
import Operation from "./reference-operation.astro";
import OperationCatalog from "./reference-catalog.astro";
import SchemaCatalog from "./schema-catalog.astro";

const { id } = Astro.locals.starlightRoute;
---

{id === "404" ? (
  <NotFound />
) : (
  <>
    {id === "" && (
      <>
        <Home />
        <div class="docs-mobile-home-actions">
          <MarkdownActions />
        </div>
      </>
    )}
    {id.startsWith("reference/") ? (
      <Operation id={id} />
    ) : id === "reference" ? (
      <OperationCatalog />
    ) : id === "referencia/esquemas" ? (
      <SchemaCatalog />
    ) : (
      <div class:list={{ "docs-home-detail": id === "" }}>
        <DefaultMarkdownContent>
          <slot />
        </DefaultMarkdownContent>
      </div>
    )}
  </>
)}
<script>
  const codePanels = document.querySelectorAll<HTMLElement>(".expressive-code pre");
  const updateOverflow = (panel: HTMLElement): void => {
    const overflow = panel.scrollWidth > panel.clientWidth;
    panel.closest(".frame")?.toggleAttribute("data-docs-overflow", overflow);
    if (overflow) panel.setAttribute("tabindex", "0");
    else panel.removeAttribute("tabindex");
  };
  const resizeObserver = new ResizeObserver((entries) => {
    entries.forEach(({ target }) => {
      if (target instanceof HTMLElement) updateOverflow(target);
    });
  });
  codePanels.forEach((panel) => {
    updateOverflow(panel);
    resizeObserver.observe(panel);
  });
  document.fonts.addEventListener("loadingdone", () => codePanels.forEach(updateOverflow));
</script>
