# Postgres
DATABASE_URL=postgres://fidy_runtime:fidy_runtime@localhost:5433/fidy
MIGRATION_DATABASE_URL=postgres://fidy:fidy@localhost:5433/fidy

# Public namespace
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
INGEST_EMAIL_DOMAIN=ingest.localhost

# WhatsApp channel (Kapso)
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_PORTFOLIO_ID=
WHATSAPP_DELIVERY_MODE=bsuid

# Observability (disabled by default; enabled local/CI capture uses the non-production project)
SENTRY_ENVIRONMENT=local
SENTRY_CAPTURE_ERRORS=false
SENTRY_CAPTURE_TRACES=false
SENTRY_NON_PRODUCTION_DSN=
SENTRY_RELEASE=
SENTRY_TRACE_SAMPLE_RATE=1

# Hosted agent
OPENAI_API_KEY=
FIDY_REPL_PHONE_NUMBER=+573001234567
FIDY_REPL_BSUID=CO.573001234567
FIDY_API_BASE_URL=http://127.0.0.1:3000
