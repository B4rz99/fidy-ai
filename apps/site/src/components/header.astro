---
import { LaunchButton } from "../islands/registration";
import ThemeToggle from "./theme-toggle.astro";

const links = [
  ["como", "Cómo funciona"],
  ["funciones", "Funciones"],
  ["precios", "Precios"],
  ["preguntas", "Preguntas frecuentes"],
];
---

<header class="wrap nav main-nav">
  <a class="logo" href="/" aria-label="Fidy, inicio">
    <img src="/fidy-logo.webp" alt="fidy" width="160" height="102" />
  </a>
  <nav class="navlinks" aria-label="Principal">
    {links.map(([id, label]) => (
      <a href={`#${id}`}>{label}</a>
    ))}
  </nav>
  <div class="navend">
    <LaunchButton dark={false} arrow={false} />
    <ThemeToggle />
    <button
      class="nav-toggle"
      type="button"
      popovertarget="compact-navigation"
      aria-label="Menú de navegación"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      >
        <path class="menu-bars" d="M4 6h16M4 12h16M4 18h16" />
        <path class="menu-close" d="M6 6l12 12M6 18 18 6" />
      </svg>
    </button>
  </div>
  <nav
    id="compact-navigation"
    class="compact-navigation"
    popover="auto"
    aria-label="Navegación compacta"
  >
    {links.map(([id, label]) => (
      <a href={`#${id}`}>{label}</a>
    ))}
  </nav>
</header>
